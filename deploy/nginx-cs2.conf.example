# Replace the two example domain names before enabling this file.
limit_req_zone $binary_remote_addr zone=cs2_per_ip:10m rate=10r/s;

# sites-enabled is included from nginx's `http` context on Ubuntu/Debian.
# `log_format` is only valid in that context, so keep it outside `server`.
log_format cs2_safe '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name csskinsprediction.online deals.csskinsprediction.online;

    # Obtain the certificate first (for example with Certbot), then keep all
    # password/session traffic on HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name csskinsprediction.online deals.csskinsprediction.online;

    ssl_certificate /etc/letsencrypt/live/csskinsprediction.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/csskinsprediction.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 2m;

    # Keep query-string dashboard tokens out of nginx access logs. The app
    # exchanges the first tokenized URL for an HttpOnly cookie immediately.
    access_log /var/log/nginx/cs2_access.log cs2_safe;

    location / {
        limit_req zone=cs2_per_ip burst=30 nodelay;
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # A database snapshot is large and expensive; never build several at once.
    location = /download/db {
        limit_req zone=cs2_per_ip burst=1 nodelay;
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_buffering off;
    }
}
