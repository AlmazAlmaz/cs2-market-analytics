# Copy to hosting.local.env. This file is only read by start_reverse_tunnel.sh.
VPS_HOST=YOUR_SERVER_IP
VPS_USER=root
VPS_SSH_PORT=22
VPS_IDENTITY_FILE=
# Optional. Prefer an SSH key. macOS can use its built-in expect helper.
VPS_PASSWORD=
REMOTE_BIND_HOST=127.0.0.1
REMOTE_PORT=8010
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8010
# Used to verify/open the real domain after reverse SSH becomes available.
PUBLIC_SITE_URL=https://csskinsprediction.online
