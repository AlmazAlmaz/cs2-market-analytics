# Copy this file to config.local.env. The local file is ignored by Git.
# Values may be left blank when the corresponding service is not used.

# Shared application paths (relative paths are resolved from this project).
CS2_DB_PATH=csfloat_history.db
CS2_STATUS_PATH=parser_status.json
CS2_SKINS_PATH=ALL_SKINS.json
CS2_SCANNER_CONTROL_PATH=deal_scanner_control.json
CS2_SCANNER_STATUS_PATH=deal_scanner_status.json
CS2_DEAL_SCANNER_LOCK_PATH=.run/deal_scanner.lock
# Offline Trend aggregates/forecasts. The worker refreshes these in background.
CS2_TREND_DB_PATH=trend_market.db
CS2_TREND_STATUS_PATH=trend_worker_status.json
CS2_TREND_LOCK_PATH=.trend_worker.lock
CS2_TREND_REFRESH_SECONDS=21600

# Isolated multi-market history. Automatic provider downloads are fail-closed:
# keep both switches false until the provider grants written rights for the
# intended storage/display/ML use. Manual private ZIP import does not need a
# provider key and never writes into csfloat_history.db.
CS2_MARKET_HISTORY_DB_PATH=.private/market_history.db
CS2_MARKET_HISTORY_STATUS_PATH=.private/market_history_status.json
CS2_MARKET_HISTORY_ENABLED=false
CS2_MARKET_HISTORY_LICENSE_CONFIRMED=false
CS2_MARKET_HISTORY_REFRESH_SECONDS=86400
CS2_MARKET_HISTORY_FETCH_SNAPSHOTS=true
CS2_MARKET_HISTORY_FETCH_SALES=true
# Sales ZIP public docs do not currently define currency/timezone semantics.
# Keep these fail-closed until the provider confirms the pinned contract in
# writing. The version should identify that written contract, not a guess.
CS2_MARKET_HISTORY_SALES_CONTRACT_CONFIRMED=false
CS2_MARKET_HISTORY_SALES_CONTRACT_VERSION=
CS2_MARKET_HISTORY_SALES_TIMESTAMPS_ARE_UTC=false
CSPRICEAPI_KEY=""
# Keep optional credentials empty in the committed example.

CSFLOAT_API_KEY=
CSFLOAT_DEBUG_API_KEY=
CSFLOAT_ROUTES_PATH=api_keys_proxies.txt

# Adaptive history parser. Lower target leaves headroom below CSFloat's page cap.
PARSER_TARGET_NEW_SALES=20
PARSER_SATURATED_TARGET_NEW_SALES=10
PARSER_MAX_CURSOR_PAGES=5
PARSER_INITIAL_EXPLORATION_DAYS=7
PARSER_USE_PAINT_INDEX=false
# A dead SOCKS route should fail over quickly; response bodies may take longer.
PARSER_CONNECT_TIMEOUT_SECONDS=15
PARSER_READ_TIMEOUT_SECONDS=60

# Local CS2 item catalog. Refresh runs only in parser_final (never in dashboard
# requests), uses conditional HTTP cache, and keeps the last good SQLite build.
CS2_CATALOG_REFRESH_ENABLED=true
CS2_CATALOG_CACHE_DIR=.private/item_catalog_cache
CS2_CATALOG_REFRESH_INTERVAL_SECONDS=86400
CS2_CATALOG_TIMEOUT_SECONDS=20
CS2_CATALOG_TOTAL_TIMEOUT_SECONDS=45
# Fill collection/case metadata from ByMykel's grouped feed. Exact variants
# still come only from skins_not_grouped.json.
CS2_CATALOG_ENRICHMENT_ENABLED=true
CS2_CATALOG_ENRICHMENT_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/skins.json
# Optional MIT-licensed cs2-items-schema cross-check/fallback (extra requests).
CS2_CATALOG_FALLBACK_ENABLED=false
# Leave blank/default unless intentionally using a compatible HTTPS mirror.
CS2_CATALOG_PRIMARY_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/skins_not_grouped.json

# Private dashboard and read-only export API.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8010
DASHBOARD_TOKEN=

# User accounts and personal inventory. Keep this database private and outside
# the exported CSFloat history database. Use the public HTTPS origin in production.
CS2_ACCOUNT_DB_PATH=.private/account_data.db
CS2_ACCOUNT_PUBLIC_URL=http://localhost:8010
CS2_ACCOUNT_REGISTRATION_ENABLED=true
CS2_ACCOUNT_COOKIE_SECURE=false
# Country stays unknown unless the site is actually behind trusted Cloudflare
# proxying that overwrites CF-IPCountry. Never enable this for direct nginx.
CS2_ACCOUNT_TRUST_CF_COUNTRY=false

# Password-reset email. Choose implicit SSL (usually 465) or STARTTLS (usually
# 587), never both. For local-only testing an opt-in 0600 outbox can be used
# instead of SMTP; do not enable it on a public server.
CS2_ACCOUNT_SMTP_HOST=
CS2_ACCOUNT_SMTP_PORT=587
CS2_ACCOUNT_SMTP_FROM=
CS2_ACCOUNT_SMTP_USERNAME=
CS2_ACCOUNT_SMTP_PASSWORD=
CS2_ACCOUNT_SMTP_SSL=false
CS2_ACCOUNT_SMTP_STARTTLS=true
CS2_ACCOUNT_DEV_EMAIL_OUTBOX=
API_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=
API_DB_PATH=csfloat_sales_history.db
API_ALLOW_QUERY_TOKEN=false

# Optional service secrets. Existing key/key2/... files remain supported.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOW_ALL=false
STEAMWEBAPI_KEY=
